{
  "name": "darkav-checklist",
  "version": "8.3.0",
  "private": true,
  "type": "module",
  "description": "سامانه چک‌لیست بازرسی درکاو — کلاینت تک‌فایلی + سرور Google Apps Script روی Google Sheets",
  "scripts": {
    "build": "node tools/build.mjs",
    "verify": "node tools/verify.mjs",
    "pretest": "node tools/build.mjs",
    "test": "node --test tests/",
    "test:server": "node --test tests/server.test.mjs",
    "test:client": "node --test tests/client.test.mjs",
    "check": "npm run build && npm run verify && npm test",
    "serve": "node tools/serve.mjs"
  },
  "devDependencies": {
    "@babel/standalone": "^7.25.0",
    "immer": "9.0.21",
    "qrcode-generator": "1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {}
}
